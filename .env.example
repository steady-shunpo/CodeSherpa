# ==============================================================================
# CodeSherpa - Environment Configuration
# ==============================================================================

# 1. E2B Sandbox API Key (Required)
# Used to spin up secure, isolated cloud sandboxes for repository testing and execution.
# Get your API key at: https://e2b.dev
E2B_API_KEY=your_e2b_api_key_here

# 2. OpenRouter API Key (Required)
# Used for LLM agent orchestration (Architect, Hint Supervisor, Implementer, Verifier).
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_ARCH_KEY=your_openrouter_api_key_here

# 3. JWT Secret Key (Required)
# Secret key used for signing authentication tokens and session security.
# Generate a secure random 32+ character string (e.g., openssl rand -hex 32)
JWT_SECRET=your_secure_random_jwt_secret_key_here

# ==============================================================================
# Optional Configurations (Defaults work out of the box for local development)
# ==============================================================================

# Database Connection (PostgreSQL with asyncpg)
# Database connection URLs need to be put in Backend/config.py


# Frontend Application URL
FRONTEND_URL=http://localhost:5173

# GitHub Personal Access Token (Optional: Increases GitHub API rate limits for repo ingestion)
# GITHUB_TOKEN=your_github_personal_access_token_here

# Google OAuth (Optional: If using Google authentication)
# GOOGLE_CLIENT_ID=your_google_client_id_here
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# REDIRECT_URI=http://localhost:8000/auth/google/callback
